generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money is stored as integer cents (never Float/Decimal-as-float) to avoid
// rounding errors — this is non-negotiable for anything touching payments.
//
// Every model that can be raced (Order, Enrollment) carries the unique
// constraint that makes the race impossible at the database level, not
// just "unlikely" at the application level.

// ---------- Auth (NextAuth / Auth.js v5 Prisma adapter shape) ----------

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  phone         String?      @unique
  passwordHash  String? // null for OAuth-only accounts
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          UserRole     @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  enrollments   Enrollment[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Catalog (v1: Courses only — Programs are v2) ----------

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  syllabus    String?
  priceCents  Int
  currency    String   @default("INR")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  enrollments Enrollment[]

  @@index([isPublished])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  amountCents Int
  currency    String
  status      OrderStatus @default(PENDING)

  // Client-generated, one per checkout attempt. The upsert-on-conflict
  // pattern in enrollment.service.ts uses this to make retried/double-
  // clicked checkout requests return the original order, not a duplicate.
  idempotencyKey String @unique

  // Payment gateway correlation IDs — also unique, so a webhook that
  // fires twice for the same gateway event can never process twice.
  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique

  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  enrollment Enrollment?

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  orderId   String   @unique
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  // THE constraint that actually prevents double-checkout: no matter how
  // many requests race, how many webhooks retry, or what application bug
  // exists upstream, Postgres will reject a second row for this pair.
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
