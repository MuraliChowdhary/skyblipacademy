generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money is stored as integer cents (never Float/Decimal-as-float) to avoid
// rounding errors — this is non-negotiable for anything touching payments.
//
// Every model that can be raced (Order, Enrollment) carries the unique
// constraint that makes the race impossible at the database level, not
// just "unlikely" at the application level.

// ---------- Auth (NextAuth / Auth.js v5 Prisma adapter shape) ----------

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  phone          String?          @unique
  passwordHash   String? // null for OAuth-only accounts
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  role           UserRole         @default(STUDENT)
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  enrollments    Enrollment[]
  LessonProgress LessonProgress[]
  Submission     Submission[]
  Bookmark       Bookmark[]
  BillingProfile BillingProfile[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BillingProfile {
  id     String @id @default(cuid())
  userId String @unique

  fullName   String?
  country    String
  state      String?
  address    String?
  city       String?
  postalCode String?
  taxId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Catalog (v1: Courses only — Programs are v2) ----------

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  syllabus    String?
  priceCents  Int
  currency    String   @default("INR")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  enrollments Enrollment[]
  modules     Module[]

  @@index([isPublished])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  amountCents Int
  currency    String
  status      OrderStatus @default(PENDING)

  // Client-generated, one per checkout attempt. The upsert-on-conflict
  // pattern in enrollment.service.ts uses this to make retried/double-
  // clicked checkout requests return the original order, not a duplicate.
  idempotencyKey String @unique

  // Payment gateway correlation IDs — also unique, so a webhook that
  // fires twice for the same gateway event can never process twice.
  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique

  failureReason String?

  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  enrollment Enrollment?

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  orderId   String   @unique
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  // THE constraint that actually prevents double-checkout: no matter how
  // many requests race, how many webhooks retry, or what application bug
  // exists upstream, Postgres will reject a second row for this pair.
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  order       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum VideoStatus {
  NOT_RECORDED
  EDITING
  PUBLISHED
}

enum LessonKind {
  STANDALONE // a normal leaf lesson — has its own content/video, no children
  OVERVIEW // a landing page that lists child topics, e.g. "Developer Foundations"
  TOPIC // a child under an OVERVIEW lesson, e.g. "Dev Environment & Tooling"
}

model Lesson {
  id               String        @id @default(cuid())
  moduleId         String
  parentId         String? // null = top-level; set = nested under an OVERVIEW lesson
  slug             String
  title            String
  order            Int
  kind             LessonKind    @default(STANDALONE)
  contentStatus    ContentStatus @default(DRAFT)
  videoStatus      VideoStatus   @default(NOT_RECORDED)
  videoUrl         String?
  notionUrl        String? // source of truth for the full write-up, for now
  learningGoals    String[] // short "what you'll learn" bullets — structured, not full content
  estimatedMinutes Int?
  keyTakeaways     String[]
  contentBody      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  module          Module           @relation(fields: [moduleId], references: [id])
  parent          Lesson?          @relation("LessonChildren", fields: [parentId], references: [id])
  children        Lesson[]         @relation("LessonChildren")
  progress        LessonProgress[]
  wrapUpQuestions WrapUpQuestion[]
  wrapUpKeyTerms  WrapUpKeyTerm[]
  Assignment      Assignment[]
  Bookmark        Bookmark[]

  @@unique([moduleId, parentId, order])
  @@unique([moduleId, slug])
  @@index([moduleId])
  @@index([parentId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id                   String         @id @default(cuid())
  userId               String
  lessonId             String
  status               ProgressStatus @default(NOT_STARTED)
  videoPositionSeconds Int            @default(0)
  lastAccessedAt       DateTime       @default(now())
  completedAt          DateTime?

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  // Same pattern as Enrollment's unique constraint — one progress row per
  // (user, lesson), upserted on every access, not inserted repeatedly.
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model WrapUpQuestion {
  id       String @id @default(cuid())
  lessonId String
  prompt   String
  answer   String @db.Text
  order    Int

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
  @@index([lessonId])
}

model WrapUpKeyTerm {
  id         String @id @default(cuid())
  lessonId   String
  term       String
  definition String @db.Text
  order      Int

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
  @@index([lessonId])
}

enum AssignmentTier {
  INLINE // small in-browser exercise, no repo needed
  REPO // bundled starter repo, user works locally
  OPEN_ENDED // spec-only build task, no skeleton provided
}

model Assignment {
  id             String         @id @default(cuid())
  lessonId       String         @unique // one assignment per lesson for v1
  title          String
  tier           AssignmentTier
  instructions   String         @db.Text // the spec/prompt, shown regardless of tier
  starterRepoUrl String? // REPO tier only
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  submissions Submission[]

  @@index([lessonId])
}

enum SubmissionStatus {
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

model Submission {
  id           String           @id @default(cuid())
  userId       String
  assignmentId String
  prUrl        String
  status       SubmissionStatus @default(SUBMITTED)
  reviewNote   String?          @db.Text
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  user       User       @relation(fields: [userId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  // One row per (user, assignment) — a resubmission updates this row and
  // resets status, rather than accumulating a new row per PR link.
  @@unique([userId, assignmentId])
  @@index([assignmentId])
  @@index([userId])
}

enum BookmarkType {
  VIDEO_TIMESTAMP
  CONTENT_SECTION
}

model Bookmark {
  id                    String       @id @default(cuid())
  userId                String
  lessonId              String
  type                  BookmarkType
  videoTimestampSeconds Int? // set when type = VIDEO_TIMESTAMP
  sectionAnchor         String? // set when type = CONTENT_SECTION — e.g. "first-principles"
  note                  String? // optional user note, e.g. "revisit before interview"
  createdAt             DateTime     @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([userId])
  @@index([lessonId])
}
